            "description": "Aceite: HTTP 201 com vínculo ao proprietário. Ajuste proprietarioId se necessário. Placa do seed (ABC1D23) → use o request de duplicada."
          }
        },
        {
          "name": "Placa duplicada (409)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Fiat\",\n  \"modelo\": \"Uno\",\n  \"placa\": \"ABC1D23\",\n  \"ano\": 2018,\n  \"cor\": \"Prata\",\n  \"proprietarioId\": 1\n}"
            },
            "url": "{{baseUrl}}/veiculos",
            "description": "Aceite: placa UNIQUE rejeitada (após seed, ABC1D23 já existe) → 409."
          }
        },
        {
          "name": "Proprietário inexistente (404)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Ford\",\n  \"modelo\": \"Ka\",\n  \"placa\": \"XYZ9Z99\",\n  \"proprietarioId\": 999999\n}"
            },
            "url": "{{baseUrl}}/veiculos",
            "description": "Aceite: ID de proprietário inexistente → 404."
          }
        },
        {
          "name": "Atualizar (PATCH)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cor\": \"Preto\"\n}"
            },
            "url": "{{baseUrl}}/veiculos/{{veiculoId}}"
          }
        },
        {
          "name": "Excluir (só admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/veiculos/{{veiculoId}}",
            "description": "200 se sem ordens; 409 se tiver ordens."
          }
        }
      ]
    },
    {
      "name": "4. Ordens de serviço",
      "item": [
        {
          "name": "Listar (JOIN + dataEntrada DESC)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ordens-servico",
            "description": "Aceite: listagem exibe veículo e proprietário relacionados (sem CPF)."
          }
        },
        {
          "name": "Listar SEM token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ordens-servico",
            "description": "Aceite: rota protegida sem token → HTTP 401."
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
